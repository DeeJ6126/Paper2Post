# --- LLM Provider（任选其一；未填 key 时会回退到 mock）---

# OpenAI（OpenAI 兼容协议）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Google Gemini
GEMINI_API_KEY=xxxxxxxx
GEMINI_MODEL=gemini-2.0-flash

# --- OpenAI 兼容的第三方服务（各自填对应 key，其余同理）---
# DeepSeek
DEEPSEEK_API_KEY=
# Qwen / DashScope
DASHSCOPE_API_KEY=
# Moonshot / Kimi
MOONSHOT_API_KEY=
# Groq
GROQ_API_KEY=
# Mistral
MISTRAL_API_KEY=
# OpenRouter
OPENROUTER_API_KEY=
# Ollama（本地，通常无需 key）
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
# vLLM（本地）
VLLM_API_KEY=
VLLM_BASE_URL=http://localhost:8000/v1

# --- 运行时输出目录 ---
PAPER2POST_OUTPUT=outputs
